# Crie um app Meta e gere um token com permissões de leitura para a conta profissional autorizada.
# Não coloque valores reais neste arquivo; copie as variáveis para .env, que é ignorado pelo Git.
INSTAGRAM_USER_ID=replace-with-authorized-instagram-professional-account-id
INSTAGRAM_ACCESS_TOKEN=replace-with-meta-access-token
META_GRAPH_API_VERSION=v25.0